// Cloudflare Workers static-assets config (used if the repo is deployed as a Worker).
// Cloudflare Pages ignores this file; for Pages use build command `npm run build` and output `dist`.
{
  "name": "order-care-prototype",
  "compatibility_date": "2026-10-01",
  // Serve the site at order-care-prototype.<account subdomain>.workers.dev.
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
